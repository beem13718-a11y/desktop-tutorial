<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | BT Auto (GarageFlow)' : 'BT Auto (GarageFlow) - ระบบจัดการอู่ซ่อมรถยนต์' %></title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  
  <!-- Font Awesome 6 (Free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  
  <div class="app-container">
    <!-- Include Sidebar -->
    <%- include('sidebar') %>

    <!-- Main Content Area -->
    <div class="main-content">
      
      <!-- Top Header Navbar -->
      <header class="top-header">
        <div class="d-flex align-items-center gap-3">
          <button class="sidebar-toggle" id="sidebarToggleBtn">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div class="h5 m-0 text-main font-weight-bold d-flex align-items-center gap-2">
            <i class="fa-solid fa-car-burst text-primary" style="font-size: 1.3rem; filter: drop-shadow(0 0 5px rgba(255, 107, 0, 0.4));"></i>
            <span style="background: linear-gradient(135deg, var(--neon-primary), #FFE600); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; letter-spacing: 0.5px;">GarageFlow</span>
          </div>
        </div>

        <!-- Horizontal Top Navbar for Desktop -->
        <nav class="top-nav d-none d-lg-flex align-items-center gap-2 mx-auto">
          <a href="/dashboard" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
            <i class="fa-solid fa-chart-line text-primary"></i> แผงควบคุม
          </a>
          <a href="/customers" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'active' : '' %>">
            <i class="fa-solid fa-users text-info"></i> ลูกค้า
          </a>
          <a href="/vehicles" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'vehicles' ? 'active' : '' %>">
            <i class="fa-solid fa-car text-success"></i> รถยนต์
          </a>
          <a href="/repairs" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'repairs' ? 'active' : '' %>">
            <i class="fa-solid fa-screwdriver-wrench text-warning"></i> งานซ่อม
          </a>
          <a href="/inventory" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'inventory' ? 'active' : '' %>">
            <i class="fa-solid fa-boxes-stacked text-info"></i> คลังอะไหล่
          </a>
          <a href="/finances" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'finances' ? 'active' : '' %>">
            <i class="fa-solid fa-wallet text-success"></i> การเงิน
          </a>
          <% if (typeof user !== 'undefined' && user && user.role === 'owner') { %>
            <a href="/mechanics" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'mechanics' ? 'active' : '' %>">
              <i class="fa-solid fa-user-gear text-info"></i> ช่างซ่อม
            </a>
          <% } %>
        </nav>
        
        <div class="header-right">
          <!-- Notification Bell -->
          <div class="notifications-dropdown">
            <button class="notifications-trigger" title="ระบบแจ้งเตือน">
              <i class="fa-solid fa-bell"></i>
              <span class="notification-badge"></span>
            </button>
          </div>
          
          <!-- User Details / Role Badge -->
          <% if (typeof user !== 'undefined' && user) { 
            let cleanFullname = (user.fullname || '').replace(/\s*\([^)]*\)/g, '').trim();
          %>
            <div class="dropdown">
              <button class="btn btn-glass-primary dropdown-toggle d-flex align-items-center gap-2 py-1.5" 
                      style="border-color: <%= user.role === 'owner' ? 'rgba(255, 107, 0, 0.35)' : 'rgba(0, 229, 255, 0.35)' %>;
                             box-shadow: 0 0 10px <%= user.role === 'owner' ? 'rgba(255, 107, 0, 0.05)' : 'rgba(0, 229, 255, 0.05)' %>;"
                      type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-avatar d-flex align-items-center justify-content-center" 
                     style="width: 26px; height: 26px; font-size: 0.75rem; border-radius: 6px; box-shadow: none; 
                            background: <%= user.role === 'owner' ? 'linear-gradient(135deg, #FF3D00, #FFE600)' : 'linear-gradient(135deg, #00E5FF, #0055FF)' %>; 
                            color: #fff; font-weight: bold; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                  <%= user.role === 'owner' ? 'จ' : 'ช' %>
                </div>
                <span class="small fw-semibold text-light"><%= cleanFullname %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end text-light" aria-labelledby="userMenuDropdown" style="background: rgba(14, 16, 22, 0.95); border: 1px solid var(--card-border); backdrop-filter: var(--glass-blur); min-width: 200px;">
                <li class="px-3 py-2 border-bottom border-secondary border-opacity-25 mb-1">
                  <div class="small text-muted" style="font-size: 0.75rem;">ผู้ปฏิบัติงาน:</div>
                  <div class="fw-bold text-light" style="font-size: 0.88rem;"><%= cleanFullname %></div>
                  <% if (user.role === 'owner') { %>
                    <span class="badge mt-1" style="background-color: rgba(255, 196, 0, 0.15) !important; color: #FFF0B3 !important; border: 1px solid rgba(255, 196, 0, 0.4) !important; font-size: 0.7rem; font-weight: 600; padding: 3px 8px;">
                      เจ้าของอู่
                    </span>
                  <% } else { %>
                    <span class="badge mt-1" style="background-color: rgba(0, 229, 255, 0.15) !important; color: #E0F7FA !important; border: 1px solid rgba(0, 229, 255, 0.4) !important; font-size: 0.7rem; font-weight: 600; padding: 3px 8px;">
                      ช่างซ่อม
                    </span>
                  <% } %>
                </li>
                <% if (user.role === 'owner') { %>
                  <li>
                    <a class="dropdown-item text-light py-2 small" href="/settings">
                      <i class="fa-solid fa-gears me-2 text-muted" style="font-size: 0.85rem;"></i>ตั้งค่าระบบ
                    </a>
                  </li>
                <% } %>
                <li>
                  <a class="dropdown-item text-danger py-2 small" href="/auth/logout">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>ออกจากระบบ
                  </a>
                </li>
              </ul>
            </div>
          <% } else { %>
            <a href="/auth/login" class="btn btn-sm btn-glass-primary">
              <i class="fa-solid fa-right-to-bracket me-1"></i> เข้าสู่ระบบ
            </a>
          <% } %>
        </div>
      </header>

      <!-- Main Content Body -->
      <main class="content-body">
