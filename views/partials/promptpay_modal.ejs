<!-- Universal PromptPay QR Code Modal -->
<div class="modal fade" id="promptPayQRModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content glass-card text-light" style="background: rgba(18, 22, 34, 0.96); border: 1px solid rgba(0, 229, 255, 0.4); border-radius: 20px; box-shadow: 0 25px 60px rgba(0,0,0,0.85);">
      <div class="modal-header border-secondary border-opacity-25 pb-2">
        <div class="d-flex align-items-center gap-2">
          <div class="bg-white rounded p-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
            <i class="fa-solid fa-qrcode text-primary" style="font-size: 1.3rem;"></i>
          </div>
          <div>
            <h6 class="modal-title fw-bold mb-0 text-light">สร้าง QR Code พร้อมเพย์รับเงิน</h6>
            <div class="text-xs text-muted">Dynamic PromptPay QR Code (สแกนได้ทุกธนาคาร)</div>
          </div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Input Form to Adjust Amount & Target -->
        <div class="row g-2 mb-3">
          <div class="col-7">
            <label for="ppInputAmount" class="form-label text-xs fw-bold text-muted mb-1">ยอดเงินที่ต้องชำระ (บาท)</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-success bg-opacity-25 text-success border border-success border-opacity-50 fw-bold">฿</span>
              <input type="number" step="0.01" class="form-control form-glass text-light fw-bold font-monospace fs-6" id="ppInputAmount" placeholder="0.00" value="0.00">
            </div>
          </div>
          <div class="col-5">
            <label for="ppInputTarget" class="form-label text-xs fw-bold text-muted mb-1">เบอร์ / เลขพร้อมเพย์</label>
            <input type="text" class="form-control form-control-sm form-glass text-light font-monospace" id="ppInputTarget" placeholder="08xxxxxxxx" value="0812345678">
          </div>
          <div class="col-12 mt-2">
            <button type="button" class="btn btn-glass-primary btn-sm w-100 py-1.5 fw-bold" id="btnRefreshPPQR">
              <i class="fa-solid fa-arrows-rotate me-1"></i> สร้าง / อัปเดต QR Code
            </button>
          </div>
        </div>

        <!-- PromptPay Printable Card Visual -->
        <div class="d-flex justify-content-center">
          <div id="promptpayCardToPrint" class="bg-white text-dark p-3 text-center shadow-lg" style="border-radius: 16px; width: 100%; max-width: 310px; border: 2px solid #002B49;">
            <!-- PromptPay Header Banner -->
            <div class="py-1.5 px-3 mb-2 rounded" style="background: linear-gradient(135deg, #002B49, #005F9E); color: #FFFFFF;">
              <div class="d-flex align-items-center justify-content-center gap-2">
                <i class="fa-solid fa-qrcode fs-5 text-warning"></i>
                <div class="fw-bold tracking-wider" style="font-size: 1.05rem; letter-spacing: 1px;">พร้อมเพย์ | PromptPay</div>
              </div>
            </div>

            <!-- Receiver Name & Account -->
            <div class="text-muted small fw-semibold mb-1 text-truncate" id="ppCardShopName">BT Auto Garage</div>
            <div class="badge bg-light text-dark border border-secondary border-opacity-25 font-monospace mb-2 px-2 py-1" style="font-size: 0.78rem;">
              พร้อมเพย์: <span id="ppCardTarget" class="fw-bold text-primary">081-234-5678</span>
            </div>

            <!-- QR Code Image Display -->
            <div class="d-flex justify-content-center align-items-center p-2 bg-light rounded-3 my-2 position-relative" style="min-height: 200px; border: 1px dashed #CBD5E1;">
              <div id="ppQRLoader" class="position-absolute d-none">
                <i class="fa-solid fa-spinner fa-spin fa-2x text-primary"></i>
              </div>
              <img id="ppQRImage" src="" alt="PromptPay QR Code" class="img-fluid rounded" style="max-height: 200px; width: auto; display: block;">
            </div>

            <!-- Amount Display -->
            <div class="mt-2 pt-2 border-top border-secondary border-opacity-25">
              <div class="text-muted text-xs">จำนวนเงินที่ต้องโอน</div>
              <div class="h3 fw-bold text-danger mb-0 font-monospace" id="ppCardAmount">฿ 0.00</div>
              <div class="text-xs text-muted mt-1" id="ppCardNote">สแกนชำระผ่านทุกแอปธนาคาร</div>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer border-secondary border-opacity-25 gap-2 justify-content-center">
        <!-- Download PNG Button -->
        <a id="btnDownloadPPQR" href="#" download="promptpay-qr.png" class="btn btn-success btn-sm px-3 py-2 fw-bold shadow-sm" style="background-color: #198754 !important;">
          <i class="fa-solid fa-download me-1"></i> ดาวน์โหลดรูปภาพ QR
        </a>
        <!-- Print Button -->
        <button type="button" class="btn btn-glass-secondary btn-sm px-3 py-2 fw-bold" onclick="printPromptPayCard()">
          <i class="fa-solid fa-print me-1"></i> พิมพ์ QR Code
        </button>
        <!-- Close Button -->
        <button type="button" class="btn btn-danger btn-sm px-3 py-2 fw-bold" data-bs-dismiss="modal" style="background-color: #dc3545 !important;">
          <i class="fa-solid fa-xmark me-1"></i> ปิด
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Print Styling for PromptPay Card -->
<style>
@media print {
  body * {
    visibility: hidden;
  }
  #promptpayCardToPrint, #promptpayCardToPrint * {
    visibility: visible;
  }
  #promptpayCardToPrint {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    box-shadow: none !important;
    border: 2px solid #000 !important;
  }
}
</style>

<script>
  // Global helper function to open PromptPay QR Modal from anywhere
  function openPromptPayModal(amount = 0, note = '', target = '') {
    const modalEl = document.getElementById('promptPayQRModal');
    if (!modalEl) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    document.getElementById('ppInputAmount').value = parseFloat(amount || 0).toFixed(2);
    if (target) document.getElementById('ppInputTarget').value = target;
    
    generateAndDisplayPPQR(amount, target, note);
    modal.show();
  }

  function generateAndDisplayPPQR(amount, target, note = '') {
    const amt = parseFloat(amount || document.getElementById('ppInputAmount').value || 0);
    const tgt = target || document.getElementById('ppInputTarget').value || '';
    const loader = document.getElementById('ppQRLoader');
    const qrImg = document.getElementById('ppQRImage');

    if (loader) loader.classList.remove('d-none');
    if (qrImg) qrImg.style.opacity = '0.3';

    fetch(`/api/qr/promptpay?amount=${amt}&promptpay_target=${encodeURIComponent(tgt)}&note=${encodeURIComponent(note)}`)
      .then(res => res.json())
      .then(data => {
        if (loader) loader.classList.add('d-none');
        if (qrImg) {
          qrImg.style.opacity = '1';
          qrImg.src = data.qrDataUrl;
        }

        // Update Card UI
        document.getElementById('ppCardAmount').textContent = '฿ ' + Number(data.amount).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('ppCardTarget').textContent = data.target;
        if (data.recipientName) {
          document.getElementById('ppCardShopName').textContent = data.recipientName;
        }
        if (data.note) {
          document.getElementById('ppCardNote').textContent = data.note;
        } else {
          document.getElementById('ppCardNote').textContent = 'สแกนชำระผ่านทุกแอปธนาคาร';
        }

        // Set Download Link
        const downloadBtn = document.getElementById('btnDownloadPPQR');
        if (downloadBtn) {
          downloadBtn.href = data.qrDataUrl;
          downloadBtn.download = `PromptPay-${data.target}-${data.amount}THB.png`;
        }
      })
      .catch(err => {
        if (loader) loader.classList.add('d-none');
        if (qrImg) qrImg.style.opacity = '1';
        console.error('[PP QR Error]:', err);
        alert('เกิดข้อผิดพลาดในการสร้าง QR Code');
      });
  }

  function printPromptPayCard() {
    window.print();
  }

  document.addEventListener('DOMContentLoaded', function() {
    const btnRefresh = document.getElementById('btnRefreshPPQR');
    if (btnRefresh) {
      btnRefresh.addEventListener('click', function() {
        const amt = document.getElementById('ppInputAmount').value;
        const tgt = document.getElementById('ppInputTarget').value;
        generateAndDisplayPPQR(amt, tgt);
      });
    }
  });
</script>
