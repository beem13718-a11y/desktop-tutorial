<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="page-title">จัดการข้อมูลช่างซ่อม</h2>
  <button class="btn btn-glass-success" data-bs-toggle="modal" data-bs-target="#addMechanicModal">
    <i class="fa-solid fa-plus me-1"></i> เพิ่มช่างซ่อมใหม่
  </button>
</div>

<!-- Filter Bar -->
<div class="glass-card mb-4 py-3">
  <form action="/mechanics" method="GET" id="mechanicFilterForm" class="row g-3">
    <div class="col-md-5 col-sm-6">
      <input type="text" class="form-control form-glass" name="search" value="<%= search %>" placeholder="ค้นหาชื่อช่างซ่อม, เบอร์โทร..." style="border-radius: 8px;">
    </div>
    <div class="col-md-4 col-sm-6">
      <select class="form-select form-glass text-light" name="status">
        <option value="">-- กรองสถานะทั้งหมด --</option>
        <option value="active" <%= status === 'active' ? 'selected' : '' %>>ปฏิบัติงานปกติ</option>
        <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>ระงับการปฏิบัติงาน</option>
      </select>
    </div>
    <div class="col-md-3 col-sm-12 d-grid">
      <button type="submit" class="btn btn-glass-primary">
        <i class="fa-solid fa-magnifying-glass me-1"></i> ค้นหาข้อมูล
      </button>
    </div>
  </form>
</div>

<!-- Mechanics Table -->
<div class="glass-card" id="mechanicsContainer">
  <div class="table-responsive">
    <table class="table-excel text-light">
      <thead>
        <tr>
          <th class="text-center" style="width: 4%;">ลำดับ</th>
          <th style="width: 16%;">ชื่อผู้ใช้งาน</th>
          <th style="width: 18%;">ชื่อ-นามสกุล</th>
          <th class="text-center" style="width: 12%;">เบอร์โทรศัพท์</th>
          <th style="width: 22%;">ทักษะความชำนาญ</th>
          <th class="text-center" style="width: 16%;">สถานะ</th>
          <th class="text-center" style="width: 12%;">การจัดการ</th>
        </tr>
      </thead>
      <tbody id="mechanicsTbody">
        <% if (mechanics.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-4">ไม่พบข้อมูลช่างซ่อมในระบบ</td>
          </tr>
        <% } else { %>
          <% mechanics.forEach((mechanic, index) => { %>
            <tr>
              <td class="text-center"><%= index + 1 %></td>
              <td class="fw-bold text-info font-monospace"><%= mechanic.username %></td>
              <td><div class="fw-bold text-light"><%= mechanic.fullname %></div></td>
              <td class="text-center font-monospace"><%= mechanic.phone || '-' %></td>
              <td class="<%= !mechanic.skills ? 'text-center' : '' %>">
                <% if (mechanic.skills) { %>
                  <div class="text-light small" title="<%= mechanic.skills %>" style="width: 100%; overflow: hidden; white-space: nowrap;"><%= mechanic.skills %></div>
                <% } else { %>
                  <span class="text-muted font-monospace">-</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (mechanic.status === 'active') { %>
                  <span class="badge text-dark font-weight-bold" style="background-color: #00E676 !important;">พร้อมปฏิบัติงาน</span>
                <% } else { %>
                  <span class="badge text-light font-weight-bold" style="background-color: #FF1744 !important;">ระงับการทำงาน</span>
                <% } %>
              </td>
              <td class="text-center">
                <button class="btn btn-sm btn-outline-info me-1 edit-mechanic-btn" 
                        data-id="<%= mechanic.id %>"
                        data-fullname="<%= mechanic.fullname %>"
                        data-phone="<%= mechanic.phone %>"
                        data-skills="<%= mechanic.skills %>"
                        data-status="<%= mechanic.status %>"
                        title="แก้ไข">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger delete-mechanic-btn" 
                        data-id="<%= mechanic.id %>"
                        data-fullname="<%= mechanic.fullname %>"
                        title="ลบ">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- ==========================================
     MODALS
     ========================================== -->

<!-- Add Mechanic Modal -->
<div class="modal fade" id="addMechanicModal" tabindex="-1" aria-labelledby="addMechanicModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content text-light" style="background: var(--bg-color); border: 1px solid var(--card-border); border-radius: 16px; backdrop-filter: var(--glass-blur);">
      <div class="modal-header border-secondary border-opacity-25">
        <h5 class="modal-title" id="addMechanicModalLabel"><i class="fa-solid fa-user-plus text-success me-2"></i>ลงทะเบียนช่างซ่อมใหม่</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addMechanicForm">
        <div class="modal-body">
          <div class="mb-3">
            <label for="addUsername" class="form-label">ชื่อผู้ใช้งานสำหรับ Login <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-glass text-light" id="addUsername" required placeholder="ภาษาอังกฤษเท่านั้น เช่น somsak_c">
          </div>
          <div class="mb-3">
            <label for="addPassword" class="form-label">รหัสผ่าน <span class="text-danger">*</span></label>
            <input type="password" class="form-control form-glass text-light" id="addPassword" required placeholder="กำหนดรหัสผ่าน...">
          </div>
          <div class="mb-3">
            <label for="addFullname" class="form-label">ชื่อ-นามสกุล <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-glass text-light" id="addFullname" required placeholder="เช่น นายสมศักดิ์ ช่างเหล็ก">
          </div>
          <div class="mb-3">
            <label for="addPhone" class="form-label">เบอร์โทรศัพท์</label>
            <input type="tel" class="form-control form-glass text-light" id="addPhone" placeholder="เช่น 0898765432">
          </div>
          <div class="mb-3">
            <label for="addSkills" class="form-label">ทักษะความชำนาญ</label>
            <textarea class="form-control form-glass text-light" id="addSkills" rows="2" placeholder="เช่น ระบบไฟฟ้ารถยนต์, จูนกล่องเครื่องยนต์..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-25">
          <button type="button" class="btn btn-secondary bg-opacity-25 border-secondary" data-bs-dismiss="modal">ยกเลิก</button>
          <button type="submit" class="btn btn-glass-success">บันทึกข้อมูล</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Mechanic Modal -->
<div class="modal fade" id="editMechanicModal" tabindex="-1" aria-labelledby="editMechanicModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content text-light" style="background: var(--bg-color); border: 1px solid var(--card-border); border-radius: 16px; backdrop-filter: var(--glass-blur);">
      <div class="modal-header border-secondary border-opacity-25">
        <h5 class="modal-title" id="editMechanicModalLabel"><i class="fa-solid fa-user-pen text-info me-2"></i>แก้ไขข้อมูลช่างซ่อม</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editMechanicForm">
        <input type="hidden" id="editMechanicId">
        <div class="modal-body">
          <div class="mb-3">
            <label for="editFullname" class="form-label">ชื่อ-นามสกุล <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-glass text-light" id="editFullname" required>
          </div>
          <div class="mb-3">
            <label for="editPhone" class="form-label">เบอร์โทรศัพท์</label>
            <input type="tel" class="form-control form-glass text-light" id="editPhone">
          </div>
          <div class="mb-3">
            <label for="editSkills" class="form-label">ทักษะความชำนาญ</label>
            <textarea class="form-control form-glass text-light" id="editSkills" rows="2"></textarea>
          </div>
          <div class="mb-3">
            <label for="editStatus" class="form-label">สถานะช่าง <span class="text-danger">*</span></label>
            <select class="form-select form-glass text-light" id="editStatus" required>
              <option value="active">พร้อมปฏิบัติงาน (Active)</option>
              <option value="inactive">ระงับการทำงานชั่วคราว (Inactive)</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-25">
          <button type="button" class="btn btn-secondary bg-opacity-25 border-secondary" data-bs-dismiss="modal">ยกเลิก</button>
          <button type="submit" class="btn btn-glass-primary">บันทึกการแก้ไข</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Fetch Javascript -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    
    // 1. Add Mechanic Form Submit
    const addForm = document.getElementById('addMechanicForm');
    addForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const payload = {
        username: document.getElementById('addUsername').value,
        password:  document.getElementById('addPassword').value,
        fullname: document.getElementById('addFullname').value,
        phone:    document.getElementById('addPhone').value,
        skills:   document.getElementById('addSkills').value
      };
      
      fetch('/mechanics/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          alert(data.message);
          window.location.reload();
        } else {
          alert('ผิดพลาด: ' + data.message);
        }
      })
      .catch(err => {
        console.error('Fetch Add Mechanic Error:', err);
        alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
      });
    });

    // 2. Edit Button Click
    const editBtns = document.querySelectorAll('.edit-mechanic-btn');
    const editModal = new bootstrap.Modal(document.getElementById('editMechanicModal'));
    
    editBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        document.getElementById('editMechanicId').value = this.dataset.id;
        document.getElementById('editFullname').value = this.dataset.fullname;
        document.getElementById('editPhone').value = this.dataset.phone === 'null' ? '' : this.dataset.phone;
        document.getElementById('editSkills').value = this.dataset.skills === 'null' ? '' : this.dataset.skills;
        document.getElementById('editStatus').value = this.dataset.status;
        
        editModal.show();
      });
    });

    // 3. Edit Form Submit
    const editForm = document.getElementById('editMechanicForm');
    editForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const id = document.getElementById('editMechanicId').value;
      const payload = {
        fullname: document.getElementById('editFullname').value,
        phone:    document.getElementById('editPhone').value,
        skills:   document.getElementById('editSkills').value,
        status:   document.getElementById('editStatus').value
      };
      
      fetch('/mechanics/edit/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          alert(data.message);
          window.location.reload();
        } else {
          alert('ผิดพลาด: ' + data.message);
        }
      })
      .catch(err => {
        console.error('Fetch Edit Mechanic Error:', err);
        alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
      });
    });

    // ==========================================
    // AJAX Live Filtering & Scroll Preservation
    // ==========================================
    const filterForm = document.getElementById('mechanicFilterForm');

    function fetchMechanicsData(url) {
      const container = document.getElementById('mechanicsContainer');
      if (container) container.style.opacity = '0.65';

      fetch(url)
        .then(res => res.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          // Swap Mechanics Container
          const newContainer = doc.getElementById('mechanicsContainer');
          if (newContainer && container) {
            container.innerHTML = newContainer.innerHTML;
            container.style.opacity = '1';
            // Re-attach edit and delete listeners on the new content!
            attachMechanicListeners();
          }

          // Update URL in address bar
          window.history.pushState({ path: url }, '', url);
        })
        .catch(err => {
          console.error('Fetch Mechanics Error:', err);
          if (container) container.style.opacity = '1';
        });
    }

    function attachMechanicListeners() {
      // Re-attach delete listeners
      const deleteBtns = document.querySelectorAll('.delete-mechanic-btn');
      deleteBtns.forEach(btn => {
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
      });

      const freshDeleteBtns = document.querySelectorAll('.delete-mechanic-btn');
      freshDeleteBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const id = this.dataset.id;
          const name = this.dataset.fullname;
          
          if (confirm(`คุณต้องการลบรายชื่อช่าง "${name}" ใช่หรือไม่?\nขั้นตอนนี้ไม่สามารถกู้คืนได้`)) {
            fetch('/mechanics/delete/' + id, {
              method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                alert(data.message);
                const searchVal = encodeURIComponent(filterForm.querySelector('input[name="search"]').value);
                const statusVal = encodeURIComponent(filterForm.querySelector('select[name="status"]').value);
                const url = `/mechanics?search=${searchVal}&status=${statusVal}`;
                fetchMechanicsData(url);
              } else {
                alert('ผิดพลาด: ' + data.message);
              }
            })
            .catch(err => {
              console.error('Fetch Delete Mechanic Error:', err);
              alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
            });
          }
        });
      });

      // Re-attach edit modal button listeners
      const editBtns = document.querySelectorAll('.edit-mechanic-btn');
      editBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          // Fill form data as normal
          document.getElementById('editId').value = this.dataset.id;
          document.getElementById('editFullname').value = this.dataset.fullname;
          document.getElementById('editPhone').value = this.dataset.phone;
          document.getElementById('editSkills').value = this.dataset.skills || '';
          document.getElementById('editStatus').value = this.dataset.status;
          
          const editModal = new bootstrap.Modal(document.getElementById('editMechanicModal'));
          editModal.show();
        });
      });
    }

    // Intercept form submit
    filterForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const searchVal = encodeURIComponent(this.querySelector('input[name="search"]').value);
      const statusVal = encodeURIComponent(this.querySelector('select[name="status"]').value);
      const url = `/mechanics?search=${searchVal}&status=${statusVal}`;
      fetchMechanicsData(url);
    });

    // Intercept select status change (auto-submit)
    const selectStatus = filterForm.querySelector('select[name="status"]');
    if (selectStatus) {
      selectStatus.addEventListener('change', function() {
        const searchInput = filterForm.querySelector('input[name="search"]');
        const searchVal = encodeURIComponent(searchInput ? searchInput.value : '');
        const statusVal = encodeURIComponent(this.value);
        const url = `/mechanics?search=${searchVal}&status=${statusVal}`;
        fetchMechanicsData(url);
      });
    }

    // Foolproof search button click
    const searchBtn = filterForm.querySelector('button[type="submit"]');
    if (searchBtn) {
      searchBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const searchInput = filterForm.querySelector('input[name="search"]');
        const selectStatus = filterForm.querySelector('select[name="status"]');
        const searchVal = encodeURIComponent(searchInput ? searchInput.value : '');
        const statusVal = encodeURIComponent(selectStatus ? selectStatus.value : '');
        const url = `/mechanics?search=${searchVal}&status=${statusVal}`;
        fetchMechanicsData(url);
      });
    }

    // Intercept Enter keypress in search input
    const searchInput = filterForm.querySelector('input[name="search"]');
    if (searchInput) {
      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          const selectStatus = filterForm.querySelector('select[name="status"]');
          const searchVal = encodeURIComponent(this.value);
          const statusVal = encodeURIComponent(selectStatus ? selectStatus.value : '');
          const url = `/mechanics?search=${searchVal}&status=${statusVal}`;
          fetchMechanicsData(url);
        }
      });
    }

    // Initial listeners
    attachMechanicListeners();

  });
</script>

<%- include('../partials/footer') %>
