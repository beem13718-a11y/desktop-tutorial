<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="page-title">รายละเอียดงานซ่อมบำรุง #<%= repair.id %></h2>
  <a href="/repairs" class="btn btn-glass-primary">
    <i class="fa-solid fa-arrow-left me-1"></i> กลับหน้าหลักงานซ่อม
  </a>
</div>

<!-- Progress Timeline -->
<div class="glass-card mb-4">
  <h5 class="text-info mb-4"><i class="fa-solid fa-bars-progress me-2"></i>ขั้นตอนความคืบหน้าการซ่อมบำรุง</h5>
  
  <%
    const statusSteps = [
      { code: 'pending', label: 'รับรถ' },
      { code: 'inspecting', label: 'ตรวจสภาพ' },
      { code: 'waiting_parts', label: 'รออะไหล่' },
      { code: 'repairing', label: 'กำลังซ่อม' },
      { code: 'checking', label: 'รอตรวจสอบ' },
      { code: 'ready', label: 'พร้อมส่งมอบ' },
      { code: 'completed', label: 'ส่งมอบแล้ว' }
    ];
    
    // Find current index
    const currentIndex = statusSteps.findIndex(s => s.code === repair.status);
  %>
  
  <div class="d-flex justify-content-between position-relative px-2 py-4 flex-wrap text-center">
    <!-- Progress Line -->
    <div class="position-absolute top-50 start-0 translate-y-middle bg-secondary bg-opacity-25 w-100 d-none d-md-block" style="height: 4px; z-index: 1;"></div>
    <% if (currentIndex >= 0) { %>
      <div class="position-absolute top-50 start-0 translate-y-middle bg-primary w-100 d-none d-md-block" style="height: 4px; width: <%= (currentIndex / (statusSteps.length - 1)) * 100 %>%; z-index: 2; transition: width 0.4s ease;"></div>
    <% } %>

    <% statusSteps.forEach((step, idx) => {
      let stepClass = 'bg-secondary text-muted';
      if (repair.status === step.code) {
        stepClass = 'bg-primary text-light border border-info border-3';
      } else if (idx < currentIndex) {
        stepClass = 'bg-success text-light';
      }
    %>
      <div class="d-flex flex-column align-items-center position-relative mb-3 mb-md-0" style="z-index: 3; width: 12%;">
        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow <%= stepClass %>" style="width: 40px; height: 40px; font-size: 0.95rem;">
          <%= idx + 1 %>
        </div>
        <div class="small fw-semibold mt-2 <%= idx <= currentIndex ? 'text-light' : 'text-muted' %>"><%= step.label %></div>
      </div>
    <% }) %>
  </div>
</div>

<div class="row g-4">
  <!-- Left Side: Basic Info & Mechanic assignment -->
  <div class="col-lg-6">
    <!-- Info Card -->
    <div class="glass-card mb-4 h-100">
      <h5 class="text-warning mb-4"><i class="fa-solid fa-circle-info me-2"></i>ข้อมูลลูกค้าและรายละเอียดรถยนต์</h5>
      
      <div class="row g-3">
        <div class="col-sm-6">
          <div class="text-muted small">ชื่อลูกค้า</div>
          <div class="text-light fw-bold mt-1"><%= repair.customer_name %></div>
        </div>
        <div class="col-sm-6">
          <div class="text-muted small">เบอร์โทรศัพท์ / อีเมล</div>
          <div class="text-light fw-bold mt-1"><%= repair.customer_phone %> / <%= repair.customer_email || '-' %></div>
        </div>
        <div class="col-12">
          <div class="text-muted small">ที่อยู่ลูกค้า</div>
          <div class="text-light mt-1"><%= repair.customer_address || '-' %></div>
        </div>
        <div class="col-sm-6">
          <div class="text-muted small">ทะเบียนรถยนต์</div>
          <div class="mt-1"><span class="badge bg-secondary border border-light text-light px-2 py-1.5"><%= repair.license_plate %></span></div>
        </div>
        <div class="col-sm-6">
          <div class="text-muted small">ยี่ห้อ / รุ่น / ปี / สี</div>
          <div class="text-light fw-bold mt-1"><%= repair.brand %> <%= repair.model %> (<%= repair.year || '-' %>) - สี <%= repair.color || '-' %></div>
        </div>
        <div class="col-12">
          <div class="text-muted small">เลขตัวถัง (VIN)</div>
          <div class="text-light mt-1 font-monospace" style="font-size: 0.85rem;"><%= repair.vin || '-' %></div>
        </div>
        <div class="col-12">
          <div class="text-muted small">รายละเอียดอาการแจ้งซ่อม</div>
          <div class="text-light bg-dark bg-opacity-50 p-3 rounded-3 mt-1" style="border: 1px solid var(--card-border);"><%= repair.description %></div>
        </div>
        <div class="col-sm-6">
          <div class="text-muted small">ราคาประเมินเบื้องต้น</div>
          <div class="text-info h4 fw-bold mt-1"><%= parseFloat(repair.estimated_cost).toLocaleString('th-TH') %> บาท</div>
        </div>
        <div class="col-sm-6">
          <div class="text-muted small">ค่าใช้จ่ายปิดงานจริง</div>
          <div class="text-success h4 fw-bold mt-1"><%= parseFloat(repair.actual_cost) > 0 ? parseFloat(repair.actual_cost).toLocaleString('th-TH') : '-' %> บาท</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Side: Action Forms -->
  <div class="col-lg-6">
    <!-- Manage Actions Card -->
    <div class="glass-card mb-4">
      <h5 class="text-info mb-4"><i class="fa-solid fa-sliders me-2"></i>จัดการขั้นตอนและมอบหมายงาน</h5>

      <!-- Action Tabs / Forms depending on role & status -->
      <div class="accordion accordion-flush bg-transparent" id="actionsAccordion">
        
        <!-- 1. Estimate price (Owner or admin only) -->
        <% if (user.role === 'owner' && (repair.status === 'pending' || repair.status === 'inspecting')) { %>
          <div class="accordion-item bg-transparent text-light border-secondary border-opacity-25">
            <h2 class="accordion-header" id="headingEstimate">
              <button class="accordion-button bg-transparent text-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEstimate" aria-expanded="false" aria-controls="collapseEstimate">
                <i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i> บันทึกราคาประเมิน (ใบเสนอราคา)
              </button>
            </h2>
            <div id="collapseEstimate" class="accordion-collapse collapse" aria-labelledby="headingEstimate" data-bs-parent="#actionsAccordion">
              <div class="accordion-body">
                <form id="estimateForm" class="row g-2">
                  <div class="col-md-8 col-sm-6">
                    <input type="number" class="form-control form-glass text-light" id="estimatedCostVal" value="<%= repair.estimated_cost %>" required placeholder="ราคาประเมินเบื้องต้น (บาท)...">
                  </div>
                  <div class="col-md-4 col-sm-6 d-grid">
                    <button type="submit" class="btn btn-glass-primary">อัปเดตใบเสนอราคา</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% } %>

        <!-- 2. Assign Mechanic & Check out spare parts -->
        <% if (repair.status !== 'completed' && repair.status !== 'cancelled' && repair.status !== 'ready') { %>
          <div class="accordion-item bg-transparent text-light border-secondary border-opacity-25">
            <h2 class="accordion-header" id="headingAssign">
              <button class="accordion-button bg-transparent text-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAssign" aria-expanded="false" aria-controls="collapseAssign">
                <i class="fa-solid fa-user-gear text-info me-2"></i> มอบหมายช่าง & เบิกสต็อกอะไหล่
              </button>
            </h2>
            <div id="collapseAssign" class="accordion-collapse collapse" aria-labelledby="headingAssign" data-bs-parent="#actionsAccordion">
              <div class="accordion-body">
                <form id="assignForm" class="g-3">
                  <!-- Mechanic Dropdown -->
                  <div class="mb-3">
                    <label for="assignMechanicId" class="form-label small">มอบหมายช่างผู้รับผิดชอบ</label>
                    <select class="form-select form-glass text-light" id="assignMechanicId">
                      <option value="">-- ไม่เปลี่ยนแปลงช่าง --</option>
                      <% mechanics.forEach(m => { %>
                        <option value="<%= m.id %>" <%= repair.mechanic_id === m.id ? 'selected' : '' %>><%= m.fullname %></option>
                      <% }) %>
                    </select>
                  </div>
                  
                  <!-- Spare parts dropdown -->
                  <div class="mb-3">
                    <label for="partId" class="form-label small">เบิกอะไหล่ (หักสต็อกอัตโนมัติ)</label>
                    <div class="row g-2">
                      <div class="col-8">
                        <select class="form-select form-glass text-light" id="partId">
                          <option value="">-- เลือกรายการอะไหล่เพื่อเบิก --</option>
                          <% inventoryParts.forEach(p => { %>
                            <option value="<%= p.id %>"><%= p.part_name %> [สต็อก: <%= p.stock_qty %>] ราคา <%= p.sell_price %> บ.</option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="col-4">
                        <input type="number" class="form-control form-glass text-light" id="partQty" value="1" min="1" placeholder="จำนวน">
                      </div>
                    </div>
                  </div>

                  <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-glass-success">บันทึกมอบหมายงาน / เบิกอะไหล่</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% } %>

        <!-- 3. Update Progress Status -->
        <% if (repair.status !== 'completed' && repair.status !== 'cancelled' && repair.status !== 'ready') { %>
          <div class="accordion-item bg-transparent text-light border-secondary border-opacity-25">
            <h2 class="accordion-header" id="headingStatus">
              <button class="accordion-button bg-transparent text-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStatus" aria-expanded="false" aria-controls="collapseStatus">
                <i class="fa-solid fa-rotate text-success me-2"></i> อัปเดตสถานะงานซ่อมบำรุง
              </button>
            </h2>
            <div id="collapseStatus" class="accordion-collapse collapse" aria-labelledby="headingStatus" data-bs-parent="#actionsAccordion">
              <div class="accordion-body">
                <form id="statusForm" class="g-3">
                  <div class="mb-3">
                    <label for="statusSelect" class="form-label small">ขั้นตอนปัจจุบัน</label>
                    <select class="form-select form-glass text-light" id="statusSelect" required>
                      <option value="pending" <%= repair.status === 'pending' ? 'selected' : '' %>>รับรถเข้าระบบ (Pending)</option>
                      <option value="inspecting" <%= repair.status === 'inspecting' ? 'selected' : '' %>>กำลังตรวจสภาพ (Inspecting)</option>
                      <option value="waiting_parts" <%= repair.status === 'waiting_parts' ? 'selected' : '' %>>รออะไหล่สำรอง (Waiting Parts)</option>
                      <option value="repairing" <%= repair.status === 'repairing' ? 'selected' : '' %>>กำลังดำเนินการซ่อม (Repairing)</option>
                      <option value="checking" <%= repair.status === 'checking' ? 'selected' : '' %>>รอตรวจสอบงาน (Checking)</option>
                      <option value="ready" <%= repair.status === 'ready' ? 'selected' : '' %>>ซ่อมเสร็จ/พร้อมส่งมอบ (Ready)</option>
                      <option value="cancelled" <%= repair.status === 'cancelled' ? 'selected' : '' %>>ยกเลิกใบสั่งซ่อม (Cancelled)</option>
                    </select>
                  </div>
                  
                  <div class="mb-3">
                    <label for="statusNotes" class="form-label small">บันทึกการทำงาน / หมายเหตุเพิ่มเติม</label>
                    <textarea class="form-control form-glass text-light" id="statusNotes" rows="2" placeholder="กรอกความก้าวหน้า เช่น เปลี่ยนหัวเทียนใหม่แล้ว, ตรวจพบลมยางซึม..."></textarea>
                  </div>

                  <div class="d-grid">
                    <button type="submit" class="btn btn-glass-primary">อัปเดตและบันทึก Log</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% } %>

        <!-- 4. Close repair job ("บันทึกปิดงาน" with actual cost & warranty) -->
        <% if (repair.status !== 'completed' && repair.status !== 'cancelled' && repair.status !== 'ready') { %>
          <div class="accordion-item bg-transparent text-light border-secondary border-opacity-25">
            <h2 class="accordion-header" id="headingClose">
              <button class="accordion-button bg-transparent text-light collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseClose" aria-expanded="false" aria-controls="collapseClose">
                <i class="fa-solid fa-flag-checkered text-danger me-2"></i> บันทึกปิดงาน (พร้อมเตรียมส่งคืนรถ)
              </button>
            </h2>
            <div id="collapseClose" class="accordion-collapse collapse" aria-labelledby="headingClose" data-bs-parent="#actionsAccordion">
              <div class="accordion-body">
                <form id="closeJobForm" enctype="multipart/form-data" class="g-3">
                  <div class="mb-3">
                    <label for="closeActualCost" class="form-label small">ค่าซ่อมจริงรวมสุทธิ (บาท) <span class="text-danger">*</span></label>
                    <!-- Prepopulate with estimated cost + sum of parts used -->
                    <%
                      let totalPartsCost = 0;
                      partsUsed.forEach(p => {
                        totalPartsCost += (parseFloat(p.sell_price) * p.quantity);
                      });
                      const defaultCloseCost = parseFloat(repair.estimated_cost) + totalPartsCost;
                    %>
                    <input type="number" class="form-control form-glass text-light" id="closeActualCost" value="<%= defaultCloseCost %>" required>
                  </div>
                  
                  <div class="mb-3">
                    <label for="closeWarrantyMonths" class="form-label small">การรับประกันงานซ่อม (เดือน)</label>
                    <select class="form-select form-glass text-light" id="closeWarrantyMonths">
                      <option value="0">ไม่มีการรับประกัน</option>
                      <option value="1">1 เดือน</option>
                      <option value="3" selected>3 เดือน</option>
                      <option value="6">6 เดือน</option>
                      <option value="12">12 เดือน (1 ปี)</option>
                    </select>
                  </div>

                  <div class="mb-3">
                    <label for="closeCarPhotoAfter" class="form-label small">รูปภาพสภาพรถยนต์หลังซ่อม (After Photo)</label>
                    <input type="file" class="form-control form-glass text-light" id="closeCarPhotoAfter" accept="image/*">
                  </div>

                  <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-glass-success">ยืนยันปิดงานและพร้อมส่งมอบ</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% } %>

      </div>

      <!-- PDF Invoice / Quotation Print trigger -->
      <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 d-grid">
        <button class="btn btn-glass-primary btn-lg" data-bs-toggle="modal" data-bs-target="#invoicePrintModal" id="btnOpenInvoiceModal">
          <i class="fa-solid fa-file-invoice-dollar me-2 text-warning"></i> พิมพ์ใบเสนอราคา / ใบเสร็จรับเงิน
        </button>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mt-2">
  <!-- Spare Parts List Table -->
  <div class="col-lg-7">
    <div class="glass-card mb-4">
      <h5 class="text-info mb-4"><i class="fa-solid fa-boxes-stacked me-2"></i>รายการอะไหล่และค่าแรงที่เบิกใช้งาน</h5>
      <div class="table-responsive">
        <table class="table-glass text-light">
          <thead>
            <tr>
              <th>รหัสอะไหล่</th>
              <th>ชื่อรายการ</th>
              <th class="text-end">ราคา/หน่วย (บาท)</th>
              <th class="text-center">จำนวน</th>
              <th class="text-end">ยอดรวม (บาท)</th>
            </tr>
          </thead>
          <tbody>
            <% if (partsUsed.length === 0) { %>
              <tr>
                <td colspan="5" class="text-center text-muted py-3">ยังไม่มีการเบิกใช้รายการอะไหล่สำหรับใบสั่งซ่อมนี้</td>
              </tr>
            <% } else { %>
              <% 
                let grandPartsTotal = 0;
                partsUsed.forEach(part => { 
                  let partTotal = parseFloat(part.sell_price) * part.quantity;
                  grandPartsTotal += partTotal;
              %>
                <tr>
                  <td class="font-monospace"><%= part.part_number %></td>
                  <td><%= part.part_name %></td>
                  <td class="text-end"><%= parseFloat(part.sell_price).toLocaleString('th-TH', {minimumFractionDigits: 2}) %></td>
                  <td class="text-center"><%= part.quantity %></td>
                  <td class="text-end fw-bold text-success"><%= partTotal.toLocaleString('th-TH', {minimumFractionDigits: 2}) %></td>
                </tr>
              <% }) %>
              <tr style="border-top: 2px solid var(--card-border);">
                <td colspan="4" class="text-end fw-bold text-light py-3">รวมค่าอะไหล่สะสม:</td>
                <td class="text-end fw-bold text-info py-3"><%= grandPartsTotal.toLocaleString('th-TH', {minimumFractionDigits: 2}) %> บาท</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Before / After Images -->
  <div class="col-lg-5">
    <div class="glass-card mb-4 h-100">
      <h5 class="text-warning mb-4"><i class="fa-solid fa-images me-2"></i>รูปภาพเปรียบเทียบ Before & After</h5>
      <div class="row g-3">
        <div class="col-6 text-center">
          <div class="text-muted small mb-2">สภาพรถตอนรับซ่อม</div>
          <% if (repair.car_photo_before) { %>
            <img src="<%= repair.car_photo_before %>" alt="Before" class="img-fluid rounded-3 border border-secondary border-opacity-50" style="max-height: 200px; object-fit: cover;">
          <% } else { %>
            <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 py-5 text-muted d-flex flex-column align-items-center justify-content-center" style="height: 150px;">
              <i class="fa-regular fa-image fa-2x mb-2 text-secondary"></i>
              <span>ไม่มีรูปภาพก่อนซ่อม</span>
            </div>
          <% } %>
        </div>

        <div class="col-6 text-center">
          <div class="text-muted small mb-2">สภาพรถหลังซ่อมเสร็จ</div>
          <% if (repair.car_photo_after) { %>
            <img src="<%= repair.car_photo_after %>" alt="After" class="img-fluid rounded-3 border border-secondary border-opacity-50" style="max-height: 200px; object-fit: cover;">
          <% } else { %>
            <div class="bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25 py-5 text-muted d-flex flex-column align-items-center justify-content-center" style="height: 150px;">
              <i class="fa-regular fa-image fa-2x mb-2 text-secondary"></i>
              <span>ไม่มีรูปภาพหลังซ่อม</span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Logs Timeline Card -->
<div class="glass-card mt-4">
  <h5 class="text-light mb-4"><i class="fa-solid fa-history me-2"></i>ประวัติปูมบันทึกความคืบหน้า (Activity Logs)</h5>
  <div style="max-height: 300px; overflow-y: auto; padding-right: 10px;">
    <% if (logs.length === 0) { %>
      <p class="text-muted italic">ไม่มีการบันทึกประวัติการเปลี่ยนแปลงใดๆ</p>
    <% } else { %>
      <div class="d-flex flex-column gap-3">
        <% logs.forEach(log => { %>
          <div class="p-3 bg-dark bg-opacity-25 rounded-3 border border-secondary border-opacity-10 d-flex justify-content-between align-items-start">
            <div>
              <span class="badge bg-secondary border border-light text-light px-2 py-0.5 me-2"><%= log.status %></span>
              <span class="text-light fw-semibold"><%= log.notes %></span>
            </div>
            <div class="text-end">
              <div class="small text-muted"><%= new Date(log.created_at).toLocaleString('th-TH') %></div>
              <small class="text-info" style="font-size: 0.8rem;"><i class="fa-solid fa-user me-1"></i><%= log.updated_by_name %></small>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- ==========================================
     MODALS
     ========================================== -->

<!-- Quotation & Invoice Print Modal with Dynamic PromptPay QR -->
<%
  let partsTotalSum = 0;
  partsUsed.forEach(p => { partsTotalSum += (parseFloat(p.sell_price) * p.quantity); });
  const finalPayAmount = parseFloat(repair.actual_cost) > 0 ? parseFloat(repair.actual_cost) : (parseFloat(repair.estimated_cost) + partsTotalSum);
  const isFinished = repair.status === 'ready' || repair.status === 'completed';
%>
<div class="modal fade" id="invoicePrintModal" tabindex="-1" aria-labelledby="invoicePrintModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content text-dark bg-white" style="border-radius: 16px;">
      <div class="modal-header border-bottom border-light">
        <h5 class="modal-title fw-bold" id="invoicePrintModalLabel">
          <i class="fa-solid fa-file-invoice me-2 text-primary"></i><%= isFinished ? 'ใบแจ้งหนี้ / ใบเสร็จรับเงิน' : 'ใบเสนอราคาค่าซ่อมบำรุง' %> (#<%= repair.id %>)
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4" id="printableInvoiceArea">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-start mb-3 pb-2 border-bottom border-dark border-2">
          <div>
            <h3 class="fw-bold m-0" style="color: #FF6B00; font-size: 1.45rem;"><i class="fa-solid fa-car-burst me-2"></i>BT AUTO GARAGE</h3>
            <p class="text-muted small m-0 mt-1" style="font-size: 0.82rem;">อู่ซ่อมบำรุงและเคาะพ่นสีรถยนต์มาตรฐานครบวงจร</p>
            <p class="text-muted small m-0" style="font-size: 0.82rem;">เบอร์โทรติดต่อ: 081-234-5678</p>
          </div>
          <div class="text-end">
            <h4 class="fw-bold m-0 text-dark" style="font-size: 1.35rem;"><%= isFinished ? 'ใบแจ้งหนี้ / ใบเสร็จรับเงิน' : 'ใบเสนอราคา (Quotation)' %></h4>
            <p class="m-0 mt-1 small font-monospace"><strong>เลขที่เอกสาร:</strong> <%= isFinished ? 'INV' : 'QT' %>-<%= repair.id.toString().padStart(5, '0') %></p>
            <p class="m-0 small"><strong>วันที่ออกเอกสาร:</strong> <%= new Date().toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
          </div>
        </div>
        
        <!-- Customer & Vehicle Details -->
        <div class="row g-2 mb-3 p-2.5 border border-secondary border-opacity-25 rounded bg-light bg-opacity-50 small" style="font-size: 0.84rem;">
          <div class="col-6">
            <h6 class="fw-bold text-uppercase text-secondary mb-1" style="font-size: 0.82rem;">ข้อมูลลูกค้า</h6>
            <p class="m-0"><strong>คุณ:</strong> <%= repair.customer_name %></p>
            <p class="m-0"><strong>เบอร์โทร:</strong> <%= repair.customer_phone %></p>
            <p class="m-0"><strong>ที่อยู่:</strong> <%= repair.customer_address || '-' %></p>
          </div>
          <div class="col-6 text-end">
            <h6 class="fw-bold text-uppercase text-secondary mb-1" style="font-size: 0.82rem;">ข้อมูลรถยนต์</h6>
            <p class="m-0"><strong>ทะเบียน:</strong> <span class="badge bg-dark text-light font-monospace px-2 py-1"><%= repair.license_plate %></span></p>
            <p class="m-0 mt-1"><strong>ยี่ห้อ / รุ่น:</strong> <%= repair.brand %> <%= repair.model %> (<%= repair.year || '-' %>)</p>
            <p class="m-0"><strong>สี / เลขตัวถัง:</strong> สี<%= repair.color || '-' %> / <%= repair.vin || '-' %></p>
          </div>
        </div>
        
        <!-- Items Table -->
        <table class="table table-bordered border-secondary border-opacity-25 small mb-3">
          <thead class="table-light border-bottom border-dark">
            <tr>
              <th style="width: 52%;">รายการค่าบริการ / อะไหล่</th>
              <th class="text-end" style="width: 18%;">ราคา/หน่วย (บาท)</th>
              <th class="text-center" style="width: 10%;">จำนวน</th>
              <th class="text-end" style="width: 20%;">ยอดรวม (บาท)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <strong>ค่าแรงช่าง & บริการตรวจเช็คซ่อมบำรุง</strong>
                <div class="text-muted" style="font-size: 0.78rem;"><%= repair.description %></div>
              </td>
              <td class="text-end"><%= parseFloat(repair.estimated_cost).toLocaleString('th-TH', {minimumFractionDigits: 2}) %></td>
              <td class="text-center">1</td>
              <td class="text-end fw-bold"><%= parseFloat(repair.estimated_cost).toLocaleString('th-TH', {minimumFractionDigits: 2}) %></td>
            </tr>
            <% partsUsed.forEach(part => { 
                let pCost = parseFloat(part.sell_price) * part.quantity;
            %>
              <tr>
                <td><%= part.part_name %> (<%= part.part_number %>)</td>
                <td class="text-end"><%= parseFloat(part.sell_price).toLocaleString('th-TH', {minimumFractionDigits: 2}) %></td>
                <td class="text-center"><%= part.quantity %></td>
                <td class="text-end fw-bold"><%= pCost.toLocaleString('th-TH', {minimumFractionDigits: 2}) %></td>
              </tr>
            <% }) %>
            <tr class="table-light border-top border-dark">
              <td colspan="3" class="text-end fw-bold">ยอดเงินรวมสุทธิที่ต้องชำระ:</td>
              <td class="text-end fw-bold text-danger" style="font-size: 1.15rem;"><%= finalPayAmount.toLocaleString('th-TH', {minimumFractionDigits: 2}) %> บาท</td>
            </tr>
          </tbody>
        </table>
        
        <!-- PromptPay QR Code & Signatures Section in Quotation -->
        <div class="border border-secondary border-opacity-25 rounded p-3 mb-3 bg-light">
          <div class="row align-items-center">
            <!-- Left: PromptPay Dynamic QR -->
            <div class="col-7">
              <div class="d-flex align-items-center">
                <!-- QR Code Box -->
                <div class="border border-dark p-1 rounded bg-white text-center shadow-sm me-3" style="width: 108px; min-width: 108px; flex-shrink: 0;">
                  <img id="quotationPPQRImg" src="" alt="PromptPay QR" style="width: 98px; height: 98px; display: block; margin: 0 auto;">
                  <div class="text-white text-center fw-bold mt-1 py-0.5 rounded" style="font-size: 0.62rem; background-color: #002B49 !important;">
                    พร้อมเพย์ PromptPay
                  </div>
                </div>
                <!-- Text Details beside QR (Spacious & Clean) -->
                <div style="padding-left: 6px;">
                  <div class="fw-bold text-dark mb-1" style="font-size: 0.9rem;">
                    <i class="fa-solid fa-qrcode text-primary me-1.5"></i> สแกนเพื่อชำระเงิน / โอนมัดจำ
                  </div>
                  <div class="text-muted small mb-1" style="font-size: 0.78rem;">สแกนผ่าน Mobile Banking ทุกธนาคาร</div>
                  <div class="fw-semibold text-dark mb-1" style="font-size: 0.84rem;">
                    พร้อมเพย์: <span class="text-primary font-monospace fw-bold" id="quotationPPTarget">081-234-5678</span>
                  </div>
                  <div class="text-danger fw-bold font-monospace mb-1" style="font-size: 0.92rem;">
                    ยอดที่ต้องชำระ: ฿ <span id="quotationPPAmount"><%= finalPayAmount.toLocaleString('th-TH', {minimumFractionDigits: 2}) %></span>
                  </div>
                  <div class="text-muted" style="font-size: 0.7rem; line-height: 1.2;">
                    * ใบเสนอราคานี้มีผลภายใน 7 วันนับจากวันที่ออกเอกสาร
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: Authorized Signature -->
            <div class="col-5 text-end">
              <div class="text-center ms-auto" style="width: 180px;">
                <div class="small text-muted mb-4" style="font-size: 0.78rem;">ลงชื่อผู้มีอำนาจออกเอกสาร</div>
                <div class="border-bottom border-dark border-opacity-75 mb-1" style="height: 15px;"></div>
                <div class="small fw-semibold text-dark" style="font-size: 0.85rem;">( <%= user.fullname %> )</div>
                <div class="text-muted" style="font-size: 0.72rem;">ผู้จัดการ / เจ้าของอู่</div>
              </div>
            </div>
          </div>
        </div>

        <div class="small text-muted italic text-center" style="font-size: 0.75rem;">
          <% if (repair.warranty_expire_date) { %>
            * รับประกันงานซ่อมถึงวันที่: <%= new Date(repair.warranty_expire_date).toLocaleDateString('th-TH') %>
          <% } else { %>
            * ขอบคุณที่ไว้วางใจใช้บริการ BT Auto Garage
          <% } %>
        </div>
      </div>
      <div class="modal-footer border-top border-light gap-2">
        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">ปิด</button>
        <button type="button" class="btn btn-success px-3 fw-bold" id="btnSendLineInvoice" onclick="sendInvoiceToLine();">
          <i class="fa-brands fa-line me-1"></i> ส่งเข้า LINE
        </button>
        <button type="button" class="btn btn-primary px-4 fw-bold" onclick="printSinglePageInvoice();">
          <i class="fa-solid fa-print me-1"></i> สั่งพิมพ์เอกสาร
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Isolated Clean Single-Page A4 Print Function
  function printSinglePageInvoice() {
    const printableArea = document.getElementById('printableInvoiceArea');
    if (!printableArea) {
      window.print();
      return;
    }

    const existingIframe = document.getElementById('invoicePrintIframe');
    if (existingIframe) {
      existingIframe.remove();
    }

    const iframe = document.createElement('iframe');
    iframe.id = 'invoicePrintIframe';
    iframe.style.position = 'fixed';
    iframe.style.right = '0';
    iframe.style.bottom = '0';
    iframe.style.width = '0';
    iframe.style.height = '0';
    iframe.style.border = '0';
    iframe.style.visibility = 'hidden';
    document.body.appendChild(iframe);

    const doc = iframe.contentWindow.document;
    doc.open();
    doc.write(`
      <!DOCTYPE html>
      <html lang="th">
      <head>
        <meta charset="UTF-8">
        <title><%= isFinished ? 'ใบแจ้งหนี้_ใบเสร็จ' : 'ใบเสนอราคา' %>_#<%= repair.id %></title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <style>
          @page {
            size: A4 portrait;
            margin: 10mm 12mm;
          }
          * {
            box-sizing: border-box !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
          }
          html, body {
            background: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
            font-size: 13px !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          }
          .table {
            width: 100% !important;
            margin-bottom: 12px !important;
            border-collapse: collapse !important;
          }
          .table th, .table td {
            padding: 6px 10px !important;
            border: 1px solid #dee2e6 !important;
            font-size: 0.85rem !important;
          }
          .table-light {
            background-color: #f8f9fa !important;
          }
          .badge {
            border: 1px solid #333 !important;
            color: #000 !important;
            background: #fff !important;
          }
        </style>
      </head>
      <body>
        <div style="padding: 10px 15px;">
          ${printableArea.innerHTML}
        </div>
      </body>
      </html>
    `);
    doc.close();

    setTimeout(() => {
      iframe.contentWindow.focus();
      iframe.contentWindow.print();
      setTimeout(() => {
        iframe.remove();
      }, 2000);
    }, 450);
  }

  // Send Invoice / Quotation to LINE
  function sendInvoiceToLine() {
    const btn = document.getElementById('btnSendLineInvoice');
    if (!btn) return;

    if (!confirm('ต้องการส่งใบเสนอราคา / ใบเสร็จรับเงินนี้เข้า LINE ใช่หรือไม่?')) {
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> กำลังส่งเข้า LINE...';

    fetch('/repairs/send-line-invoice/<%= repair.id %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-brands fa-line me-1"></i> ส่งเข้า LINE';
      if (data.success) {
        alert(data.message);
      } else {
        alert('⚠️ ส่ง LINE ไม่สำเร็จ: ' + data.message);
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-brands fa-line me-1"></i> ส่งเข้า LINE';
      console.error(err);
      alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
    });
  }

  // Load Dynamic PromptPay QR into Quotation Sheet
  function loadQuotationPromptPayQR() {
    const finalAmount = <%= finalPayAmount %>;
    const qrImg = document.getElementById('quotationPPQRImg');
    if (!qrImg) return;

    fetch(`/api/qr/promptpay?amount=${finalAmount}&note=${encodeURIComponent('ค่างานซ่อม #<%= repair.id %> (<%= repair.license_plate %>)')}`)
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          qrImg.src = data.qrDataUrl;
          const targetEl = document.getElementById('quotationPPTarget');
          if (targetEl) targetEl.textContent = data.target;
        }
      })
      .catch(err => console.error('[Quotation QR Error]:', err));
  }

  document.addEventListener('DOMContentLoaded', function() {
    loadQuotationPromptPayQR();
  });
</script>


<!-- Javascript for Repair Actions -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const repairId = '<%= repair.id %>';

    // 1. Submit price estimate
    const estimateForm = document.getElementById('estimateForm');
    if (estimateForm) {
      estimateForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const cost = document.getElementById('estimatedCostVal').value;
        
        fetch(`/repairs/estimate/${repairId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ estimated_cost: cost })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('ผิดพลาด: ' + data.message);
          }
        })
        .catch(err => {
          console.error(err);
          alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
        });
      });
    }

    // 2. Submit assign mechanic and check out parts
    const assignForm = document.getElementById('assignForm');
    if (assignForm) {
      assignForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const mechanicId = document.getElementById('assignMechanicId').value;
        const partId = document.getElementById('partId').value;
        const qty = document.getElementById('partQty').value;
        
        fetch(`/repairs/assign-parts/${repairId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mechanic_id: mechanicId || null,
            part_id: partId || null,
            quantity: partId ? qty : null
          })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('ผิดพลาด: ' + data.message);
          }
        })
        .catch(err => {
          console.error(err);
          alert('เกิดข้อผิดพลาดในการส่งข้อมูล');
        });
      });
    }

    // 3. Submit status change
    const statusForm = document.getElementById('statusForm');
    if (statusForm) {
      statusForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const status = document.getElementById('statusSelect').value;
        const notes = document.getElementById('statusNotes').value;
        
        fetch(`/repairs/status/${repairId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, notes })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('ผิดพลาด: ' + data.message);
          }
        })
        .catch(err => {
          console.error(err);
          alert('เกิดข้อผิดพลาดในการอัปเดตสถานะ');
        });
      });
    }

    // 4. Submit Close Job Form (with file upload)
    const closeForm = document.getElementById('closeJobForm');
    if (closeForm) {
      closeForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData();
        formData.append('actual_cost', document.getElementById('closeActualCost').value);
        formData.append('warranty_months', document.getElementById('closeWarrantyMonths').value);
        
        const photoFile = document.getElementById('closeCarPhotoAfter').files[0];
        if (photoFile) {
          formData.append('car_photo_after', photoFile);
        }
        
        fetch(`/repairs/close/${repairId}`, {
          method: 'POST',
          body: formData
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('ผิดพลาด: ' + data.message);
          }
        })
        .catch(err => {
          console.error(err);
          alert('เกิดข้อผิดพลาดในการส่งข้อมูล');
        });
      });
    }

  });
</script>

<%- include('../partials/footer') %>
