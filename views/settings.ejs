<%- include('partials/header') %>

<div class="mb-4">
  <h2 class="page-title">จัดการควบคุมระบบ</h2>
  <div class="text-muted small mt-1">ตั้งค่าผู้ใช้งาน สำรองข้อมูลระบบ และส่องบันทึกความคืบหน้ากิจกรรมแอดมิน</div>
</div>

<div class="row g-4">
  <!-- Left Side: User management & Backup -->
  <div class="col-lg-6">
    <!-- Staff Reset Password Card -->
    <div class="glass-card mb-4">
      <h5 class="text-warning mb-4"><i class="fa-solid fa-key me-2"></i>เปลี่ยนรหัสผ่านผู้ปฏิบัติงาน</h5>
      <form id="changePasswordForm" class="g-3">
        <div class="mb-3">
          <label for="staffUser" class="form-label small">เลือกพนักงาน / ผู้ใช้งาน</label>
          <select class="form-select form-glass text-light" id="staffUser" required>
            <option value="" disabled selected>-- เลือกผู้ปฏิบัติงาน --</option>
            <% staffList.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.fullname %> (<%= s.username %>) - [<%= s.role %>]</option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label for="newPassword" class="form-label small">รหัสผ่านใหม่ (อย่างน้อย 6 ตัวอักษร)</label>
          <input type="password" class="form-control form-glass text-light" id="newPassword" minlength="6" required placeholder="กรอกรหัสผ่านใหม่...">
        </div>
        <div class="d-grid">
          <button type="submit" class="btn btn-glass-primary">ยืนยันเปลี่ยนรหัสผ่าน</button>
        </div>
      </form>
    </div>

    <!-- PromptPay & Bank Settings Card -->
    <div class="glass-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-warning mb-0"><i class="fa-solid fa-qrcode me-2 text-warning"></i>ตั้งค่าพร้อมเพย์ & บัญชีรับเงิน (PromptPay)</h5>
        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning">Dynamic QR Code</span>
      </div>
      <p class="text-muted small mb-4">กำหนดเบอร์พร้อมเพย์และชื่อบัญชีอู่ สำหรับสร้าง QR Code รับเงินในใบเสนอราคาและใบเสร็จรับเงินอัตโนมัติ</p>

      <form id="paymentConfigForm" class="g-3">
        <div class="mb-3">
          <label for="promptpayNumber" class="form-label text-light fw-bold small">
            <i class="fa-solid fa-mobile-screen-button text-success me-1"></i> เบอร์โทรศัพท์ / เลขประจำตัวผู้เสียภาษีพร้อมเพย์ <span class="text-danger">*</span>
          </label>
          <p class="text-muted" style="font-size: 0.75rem; margin-top: -5px; line-height: 1.3;">กรอกเบอร์มือถือ 10 หลัก (เช่น <code>0812345678</code>) หรือเลขประจำตัวผู้เสียภาษี/นิติบุคคล 13 หลัก</p>
          <input type="text" class="form-control form-glass text-light font-monospace fw-bold" id="promptpayNumber" value="<%= lineSettings.promptpay_number || '0812345678' %>" placeholder="เช่น 0812345678 หรือ 010555xxxxxxx" required>
        </div>

        <div class="mb-3">
          <label for="promptpayName" class="form-label text-light fw-bold small">
            <i class="fa-solid fa-store text-info me-1"></i> ชื่อบัญชี / ชื่อร้านค้าที่จะแสดงบน QR Code
          </label>
          <input type="text" class="form-control form-glass text-light" id="promptpayName" value="<%= lineSettings.promptpay_name || 'BT Auto Garage' %>" placeholder="เช่น อู่ บีที ออโต้ เซอร์วิส">
        </div>

        <div class="row g-2 mb-3">
          <div class="col-sm-6">
            <label for="bankName" class="form-label text-light small fw-bold"><i class="fa-solid fa-building-columns text-warning me-1"></i> ธนาคาร</label>
            <input type="text" class="form-control form-glass text-light" id="bankName" value="<%= lineSettings.bank_name || 'กสิกรไทย (KBANK)' %>" placeholder="เช่น กสิกรไทย, ไทยพาณิชย์">
          </div>
          <div class="col-sm-6">
            <label for="bankAccountNo" class="form-label text-light small fw-bold"><i class="fa-solid fa-credit-card text-info me-1"></i> เลขที่บัญชีธนาคาร</label>
            <input type="text" class="form-control form-glass text-light font-monospace" id="bankAccountNo" value="<%= lineSettings.bank_account_no || '' %>" placeholder="เช่น 123-4-56789-0">
          </div>
        </div>

        <div class="d-grid mt-4">
          <button type="submit" class="btn btn-warning text-dark fw-bold shadow-sm" style="background-color: #ffc107 !important; border-color: #ffc107 !important;">
            <i class="fa-solid fa-floppy-disk me-1"></i> บันทึกข้อมูลพร้อมเพย์ & บัญชีรับเงิน
          </button>
        </div>
      </form>
    </div>

    <!-- LINE Integration Card -->
    <div class="glass-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-info mb-0"><i class="fa-brands fa-line me-2 text-success" style="font-size: 1.35rem;"></i>เชื่อมต่อระบบ LINE (LINE Official Account)</h5>
        <span class="badge bg-success bg-opacity-25 text-success border border-success">Messaging API</span>
      </div>
      <p class="text-muted small mb-4">ระบบแจ้งเตือนแบบใหม่ผ่าน LINE Official Account ส่งตรงหาลูกค้าและกลุ่มช่างแบบอัตโนมัติด้วยการ์ด Flex Message</p>
      
      <form id="lineConfigForm" class="g-3">
        <!-- LINE Messaging API Channel Access Token -->
        <div class="mb-3">
          <label for="lineChannelToken" class="form-label text-light fw-bold small"><i class="fa-solid fa-key text-warning me-1"></i> 1. LINE OA Channel Access Token (Long-lived) <span class="text-danger">*</span></label>
          <p class="text-muted" style="font-size: 0.75rem; margin-top: -5px; line-height: 1.3;">นำมาจาก LINE Developers Console &gt; Messaging API &gt; Channel access token</p>
          <input type="password" class="form-control form-glass text-light" id="lineChannelToken" value="<%= lineSettings.line_channel_token || '' %>" placeholder="กรอก Channel Access Token (ขึ้นต้นด้วย v1/v2 หรือตัวอักษรยาวๆ)...">
        </div>
        
        <!-- LINE Owner User ID -->
        <div class="mb-3">
          <label for="lineAdminId" class="form-label text-light fw-bold small"><i class="fa-solid fa-user-shield text-info me-1"></i> 2. LINE User ID ของเจ้าของร้าน (แจ้งเตือน & สั่งการส่วนตัว 1-on-1)</label>
          <p class="text-muted" style="font-size: 0.75rem; margin-top: -5px; line-height: 1.3;">User ID บัญชีส่วนตัวของคุณ (ขึ้นต้นด้วย <code>U...</code> ดูได้จากด้านล่างสุดของแท็บ Basic settings ใน LINE Developers Console)</p>
          <input type="text" class="form-control form-glass text-light" id="lineAdminId" value="<%= lineSettings.line_admin_id || '' %>" placeholder="เช่น U1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d">
        </div>

        <!-- LINE Channel Secret -->
        <div class="mb-3">
          <label for="lineChannelSecret" class="form-label text-light fw-bold small"><i class="fa-solid fa-shield-halved text-secondary me-1"></i> 3. LINE OA Channel Secret</label>
          <input type="password" class="form-control form-glass text-light" id="lineChannelSecret" value="<%= lineSettings.line_channel_secret || '' %>" placeholder="กรอก Channel Secret (ดูได้จากแท็บ Basic settings)...">
        </div>

        <div class="row g-2 mt-4">
          <div class="col-sm-7">
            <button type="submit" class="btn btn-glass-success w-100">
              <i class="fa-solid fa-floppy-disk me-1"></i> บันทึกการตั้งค่า LINE
            </button>
          </div>
          <div class="col-sm-5">
            <button type="button" id="btnTestLine" class="btn btn-glass-primary w-100">
              <i class="fa-solid fa-paper-plane me-1"></i> ทดสอบส่ง LINE
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Backup & Restore Card -->
    <div class="glass-card mb-4">
      <h5 class="text-success mb-4"><i class="fa-solid fa-database me-2"></i>ระบบสำรองและกู้คืนฐานข้อมูล (Database Backup / Restore)</h5>
      
      <div class="mb-4">
        <h6 class="text-light fw-bold small mb-2">1. สำรองข้อมูล (Backup Database)</h6>
        <p class="text-muted small">ระบบจะสร้างไฟล์และดาวน์โหลดคำสั่ง SQL สำหรับสำรองโครงสร้างตารางและข้อมูลทั้งหมดในปัจจุบัน</p>
        <a href="/settings/backup" class="btn btn-glass-success w-100">
          <i class="fa-solid fa-download me-1"></i> ดาวน์โหลดไฟล์สำรองข้อมูล (.sql)
        </a>
      </div>

      <hr class="border-secondary border-opacity-25 my-4">

      <div>
        <h6 class="text-light fw-bold small mb-2">2. กู้คืนข้อมูล (Restore Database)</h6>
        <p class="text-muted small text-danger">* คำเตือน: การกู้คืนข้อมูลจะทำการลบตารางปัจจุบันและแทนที่ด้วยข้อมูลจากไฟล์ SQL ที่อัปโหลด</p>
        <form id="restoreDbForm" class="g-3">
          <div class="mb-3">
            <input type="file" class="form-control form-glass text-light" id="restoreFile" accept=".sql" required>
          </div>
          <div class="d-grid">
            <button type="submit" class="btn btn-glass-primary bg-opacity-10 border-danger text-danger btn-restore">
              <i class="fa-solid fa-upload me-1"></i> ยืนยันการกู้คืนข้อมูลเข้าระบบ
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Right Side: Audit Logs Table -->
  <div class="col-lg-6">
    <div class="glass-card h-100">
      <h5 class="text-info mb-4"><i class="fa-solid fa-clipboard-list me-2"></i>บันทึกความปลอดภัยระบบ (Audit Logs)</h5>
      
      <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
        <table class="table-glass text-light">
          <thead>
            <tr>
              <th>วัน-เวลา</th>
              <th>แอดมิน</th>
              <th>การกระทำ</th>
              <th>รายละเอียดเพิ่มเติม</th>
            </tr>
          </thead>
          <tbody>
            <% if (auditLogs.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-3">ยังไม่พบบันทึกการเคลื่อนไหวระบบ</td>
              </tr>
            <% } else { %>
              <% auditLogs.forEach(log => { %>
                <tr>
                  <td style="font-size: 0.8rem;" class="text-muted"><%= new Date(log.created_at).toLocaleString('th-TH') %></td>
                  <td class="fw-semibold text-light" style="font-size: 0.85rem;"><%= log.user_fullname %></td>
                  <td>
                    <span class="badge bg-secondary border border-light text-light" style="font-size: 0.75rem;"><%= log.action %></span>
                  </td>
                  <td style="font-size: 0.85rem;" class="text-muted"><%= log.details %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Scripts for Settings Actions -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    
    // 1. Password change form submit
    const pwForm = document.getElementById('changePasswordForm');
    pwForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const payload = {
        staff_id: document.getElementById('staffUser').value,
        new_password: document.getElementById('newPassword').value
      };
      
      fetch('/settings/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          alert(data.message);
          pwForm.reset();
        } else {
          alert('ผิดพลาด: ' + data.message);
        }
      })
      .catch(err => {
        console.error(err);
        alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
      });
    });

    // 2. Restore DB Upload and POST
    const restoreForm = document.getElementById('restoreDbForm');
    restoreForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const fileInput = document.getElementById('restoreFile');
      const file = fileInput.files[0];
      
      if (!file) {
        alert('กรุณาเลือกไฟล์สำรองข้อมูล .sql ก่อนทำการกู้คืน');
        return;
      }
      
      if (!confirm('คำเตือนความปลอดภัย:\nคุณแน่ใจว่าต้องการลบโครงสร้างตารางข้อมูลทั้งหมด และกู้คืนข้อมูลจากไฟล์นี้ใช่หรือไม่?\nการกระทำนี้จะสลับลบข้อมูลปัจจุบันทั้งหมดทันที!')) {
        return;
      }
      
      // Use FileReader to read file content
      const reader = new FileReader();
      reader.onload = function(event) {
        const sqlContent = event.target.result;
        
        fetch('/settings/restore', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sql_content: sqlContent })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('ไม่สามารถกู้คืนได้: ' + data.message);
          }
        })
        .catch(err => {
          console.error(err);
          alert('เกิดข้อผิดพลาดทางเทคนิคในการส่งไฟล์กู้คืน');
        });
      };
      
      reader.readAsText(file);
    });

    // 2.5 PromptPay settings form submit
    const paymentForm = document.getElementById('paymentConfigForm');
    if (paymentForm) {
      paymentForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const payload = {
          promptpay_number: document.getElementById('promptpayNumber').value,
          promptpay_name: document.getElementById('promptpayName').value,
          bank_name: document.getElementById('bankName').value,
          bank_account_no: document.getElementById('bankAccountNo').value
        };
        
        fetch('/settings/payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('✅ ' + data.message);
            window.location.reload();
          } else {
            alert('⚠️ ' + data.message);
          }
        })
        .catch(err => {
          console.error(err);
          alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
        });
      });
    }

    // 3. LINE settings form submit
    const lineForm = document.getElementById('lineConfigForm');
    if (lineForm) {
      lineForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const payload = {
          line_channel_token: document.getElementById('lineChannelToken').value,
          line_admin_id: document.getElementById('lineAdminId').value,
          line_channel_secret: document.getElementById('lineChannelSecret').value
        };
        
        fetch('/settings/line', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            window.location.reload();
          } else {
            alert('ผิดพลาด: ' + data.message);
          }
        })
        .catch(err => {
          console.error(err);
          alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
        });
      });
    }

    // 4. Test LINE Notification Button
    const btnTestLine = document.getElementById('btnTestLine');
    if (btnTestLine) {
      btnTestLine.addEventListener('click', function() {
        const adminId = document.getElementById('lineAdminId').value;
        const channelToken = document.getElementById('lineChannelToken').value;

        if (!channelToken) {
          alert('กรุณากรอก LINE OA Channel Access Token ก่อนกดทดสอบ');
          return;
        }

        if (!adminId) {
          alert('กรุณากรอก LINE Admin User ID (เช่น U1a2b3c4...) เพื่อระบุผู้รับข้อความทดสอบ');
          return;
        }

        btnTestLine.disabled = true;
        btnTestLine.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> กำลังส่ง...';

        fetch('/settings/line/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_id: adminId })
        })
        .then(res => res.json())
        .then(data => {
          btnTestLine.disabled = false;
          btnTestLine.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> ทดสอบส่ง LINE';
          if (data.success) {
            alert('🎉 ' + data.message);
          } else {
            alert('⚠️ ส่งข้อความไม่สำเร็จ: ' + data.message);
          }
        })
        .catch(err => {
          btnTestLine.disabled = false;
          btnTestLine.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> ทดสอบส่ง LINE';
          console.error(err);
          alert('เกิดข้อผิดพลาดในการเชื่อมต่อ');
        });
      });
    }

  });
</script>

<%- include('partials/footer') %>
