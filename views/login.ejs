<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | BT Auto (GarageFlow)</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background-image: 
        radial-gradient(at 20% 20%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
        radial-gradient(at 80% 80%, rgba(14, 165, 233, 0.15) 0px, transparent 50%);
    }
    
    .login-container {
      width: 100%;
      max-width: 450px;
      padding: 15px;
    }
    
    .login-logo {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, #818CF8, #34D399);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-align: center;
      margin-bottom: 25px;
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="text-center">
      <div class="login-logo">
        <i class="fa-solid fa-car-burst me-2"></i>GarageFlow
      </div>
    </div>
    
    <div class="glass-card">
      <h3 class="text-center mb-4 text-main font-weight-bold">ลงชื่อเข้าใช้งานระบบ</h3>
      <p class="text-muted text-center mb-4" style="font-size: 0.9rem;">BT Auto Garage Management System</p>
      
      <% if (error) { %>
        <div class="alert alert-danger border-0 text-light bg-danger bg-opacity-25 mb-4" role="alert" style="border-radius: 8px;">
          <i class="fa-solid fa-triangle-exclamation me-2"></i> <%= error %>
        </div>
      <% } %>
      
      <form action="/auth/login" method="POST">
        <div class="mb-3">
          <label for="username" class="form-label text-light">ชื่อผู้ใช้งาน (Username)</label>
          <input type="text" class="form-control form-glass text-light" id="username" name="username" value="<%= typeof username !== 'undefined' && username ? username : '' %>" placeholder="กรอกชื่อผู้ใช้งาน..." required style="border-radius: 8px;">
        </div>
        
        <div class="mb-4">
          <label for="password" class="form-label text-light">รหัสผ่าน (Password)</label>
          <input type="password" class="form-control form-glass text-light" id="password" name="password" placeholder="กรอกรหัสผ่าน..." required style="border-radius: 8px;">
        </div>
        
        <button type="submit" class="btn btn-glass-primary w-100 py-2.5 font-weight-bold">
          <i class="fa-solid fa-right-to-bracket me-2"></i> เข้าสู่ระบบ
        </button>
      </form>
      
      <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center" style="font-size: 0.8rem; color: var(--text-muted);">
        <span>พาสเวิร์ดทดสอบ: owner / owner123 หรือ mechanic / mechanic123</span>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
